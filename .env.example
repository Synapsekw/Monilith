# Pulse — environment template. Copy to .env.local and fill in real values.
# Supabase → Project Settings → API

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret. NEVER prefix with NEXT_PUBLIC_. Must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase personal access token (sbp_…) from https://supabase.com/dashboard/account/tokens
# Used by scripts/push-auth-emails.ts to push branded auth email templates to the hosted project.
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# Server-only. Powers AI dashboard generation (Anthropic Opus 4.8).
ANTHROPIC_API_KEY=

# --- /sync-prod (publish dev data → prod). Real values go in .env.prod.local (gitignored). ---
# Prod project: jzsyqhxynswolgijkktn  (DEV is the existing NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above)
PROD_SUPABASE_URL=https://jzsyqhxynswolgijkktn.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection strings (used by the shell scripts: dump/restore/backup).
DEV_SUPABASE_DB_URL=
PROD_SUPABASE_DB_URL=
