# Pulse — environment template. Copy to .env.local and fill in real values.
# Supabase → Project Settings → API

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret. NEVER prefix with NEXT_PUBLIC_. Must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase personal access token (sbp_…) from https://supabase.com/dashboard/account/tokens
# Used by scripts/push-auth-emails.ts to push branded auth email templates to the hosted project.
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# Server-only. Powers AI dashboard generation (Anthropic Opus 4.8).
ANTHROPIC_API_KEY=

# --- /sync-prod (publish dev data → prod). Real values go in .env.prod.local (gitignored). ---
# Prod project: jzsyqhxynswolgijkktn  (DEV is the existing NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above)
PROD_SUPABASE_URL=https://jzsyqhxynswolgijkktn.supabase.co
PROD_SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection strings for the dump/restore/backup scripts. Use each project's
# SESSION POOLER URI (Dashboard → Connect → Session pooler) — it is IPv4-friendly and works with
# psql/pg_dump. Shape: postgresql://postgres.<project-ref>:<db-password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# (NOT the https API URL, and NOT the transaction pooler on :6543).
DEV_SUPABASE_DB_URL=
PROD_SUPABASE_DB_URL=
# Optional: absolute path to your PostgreSQL bin dir, if psql/pg_dump are not on PATH.
# e.g. /c/Program Files/PostgreSQL/17/bin   (Windows)  or  /opt/homebrew/opt/postgresql@17/bin (macOS)
PG_BIN=

# --- Isolated test database (integration suites). Real values go in .env.test (gitignored). ---
# Provision a DEDICATED Supabase project, apply supabase/migrations to it, then fill these.
# The 38 *.integration.test.ts(x) suites + the global-teardown sweeper use these and NEVER
# touch DEV/PROD. WITHOUT .env.test, integration suites SKIP (the default — no DEV pollution);
# running them is opt-in. See CONTRIBUTING.md → "Running integration tests" for the full setup.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_TEST_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=test-project-anon-or-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=test-project-service-role-key
# PULSE_TEST_DB=1   # REQUIRED opt-in marker; the destructive purge refuses to run without it

# --- Weekly health digest (all optional — the feature self-disables without them) ---
# DIGEST_SECRET=            # 32+ random bytes; same value as the Vault 'digest_secret'
# RESEND_API_KEY=           # re_…; absent → in-app-only digests (no email)
# APP_BASE_URL=             # e.g. https://pulse.example.com (absolute links in emails)
# DIGEST_FROM_EMAIL=        # verified Resend sender, e.g. digest@pulse.example.com
