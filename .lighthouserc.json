{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready in|started server on|Local:",
      "startServerReadyTimeout": 60000,
      "url": ["http://localhost:3000/"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 1500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "server-response-time": ["warn", { "maxNumericValue": 200 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 300000 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
