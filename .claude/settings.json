{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(supabase *)",
      "Bash(pnpm supabase *)",
      "Bash(bash scripts/supabase-rest.sh *)",
      "Bash(./scripts/supabase-rest.sh *)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build)",
      "Bash(pnpm build:*)",
      "Bash(pnpm db:types)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git log)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/maybe-write-session.mjs"
          }
        ]
      }
    ]
  }
}
