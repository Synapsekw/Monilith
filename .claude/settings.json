{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(supabase *)",
      "Bash(pnpm supabase *)",
      "Bash(bash scripts/supabase-rest.sh *)",
      "Bash(./scripts/supabase-rest.sh *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/maybe-write-session.mjs"
          }
        ]
      }
    ]
  }
}
