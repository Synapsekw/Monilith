# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# mcp — commit .mcp.json (OAuth, no secret) but never any local/token variant
.mcp.local.json
.mcp.*.local.json

# supabase local
supabase/.branches
supabase/.temp
supabase/.env

# typescript
*.tsbuildinfo
next-env.d.ts

# Obsidian dev-memory vault — TRACKED (vault/ notes + stable .obsidian config,
# incl. community-plugins.json so the plugin set is reproducible). Volatile
# per-machine state and installed plugin binaries are ignored.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
# Ignore plugin binaries, but TRACK the homepage choice so it survives a clone.
.obsidian/plugins/*
!.obsidian/plugins/homepage/
.obsidian/plugins/homepage/*
!.obsidian/plugins/homepage/data.json

# Stale old vault location (vault now lives at repo-root vault/). Keep on disk, never commit.
/Monolith/

# Claude Code — share project settings + commands/hooks, but never machine-local settings.
.claude/settings.local.json

# Volatile Obsidian graph view-state (not knowledge)
.obsidian/graph.json
