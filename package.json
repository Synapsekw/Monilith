{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "next experimental-analyze",
    "start": "next start",
    "lint": "eslint && node scripts/check-hover-tokens.mjs && node scripts/check-px-text.mjs && node scripts/check-board-chrome.mjs",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --linked --schema public | prettier --parser typescript > src/types/database.types.ts",
    "db:ledger-check": "node scripts/check-migration-ledger.mjs",
    "changelog:gen": "tsx scripts/generate-changelog.ts && prettier --write src/lib/changelog/generated.ts",
    "test": "vitest run --project unit --project conformance --project fixtures",
    "test:unit": "vitest run --project unit",
    "test:conformance": "vitest run --project conformance",
    "test:fixtures": "vitest run --project fixtures",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "lhci": "lhci autorun",
    "e2e": "playwright test",
    "e2e:offline": "playwright test -c playwright.offline.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "sync:storage": "tsx scripts/sync-prod/sync-storage.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/openai": "^4.0.111",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@anthropic-ai/sdk": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.21.0",
    "@hookform/resolvers": "^6.0.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "ai": "^7.0.166",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.11.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.70.0",
    "mcp-handler": "^2.3.1",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "openai": "^7.54.0",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-grid-layout": "^2.3.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@lhci/cli": "^0.16.0",
    "@next/bundle-analyzer": "16.4.6",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "vitest": "^5.1.0"
  }
}
